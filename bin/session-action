#!/usr/bin/env bash
# Acoes de sessao e midia do Quickshell "mine" (atalhos do Hyprland).
#   session-action lock                              bloqueia a tela
#   session-action menu                              abre o menu de energia
#   session-action media toggle|next|previous|stop   teclas de midia (o shell mostra o que esta tocando)
# Se o shell nao estiver rodando (caiu?), inicia antes: o bloqueio de tela depende dele.
if ! pgrep -f "^(/usr/bin/)?qs -c mine( |$)" >/dev/null; then
    "$HOME/.local/bin/mine-shell" start >/dev/null 2>&1 || exit 1
    sleep 1
fi
case "$1" in
    lock)  exec qs -c mine ipc call session lock ;;
    menu)  exec qs -c mine ipc call session menu ;;
    media) exec qs -c mine ipc call media "${2:-toggle}" ;;
    *)     echo "uso: session-action {lock|menu|media toggle|next|previous|stop}"; exit 1 ;;
esac
